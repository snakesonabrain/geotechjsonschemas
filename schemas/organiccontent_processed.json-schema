{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/organiccontent_processed.json-schema",
    "title": "Organic content (loss on ignition) processed test data",
    "description": "JSON schema for processed data of organic content test (loss on ignition)",
    "type": "object",
    "properties": {
        "testpoints": {
            "description": "Array with results of the individual tests (different specimens)",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "Organic content [%]": {
                        "description": "Organic content of the specimen",
                        "type": "number"
                    }
                },
                "required": ["Organic content [%]"]
            }
        },
        "Average organic content [%]": {
            "description": "Average of the organic content tests (number used in reporting)",
            "type": "number"
        },
        "processing": {
            "description": "Test processing metadata",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/processing.json-schema"
        }
    },
    "required": ["testpoints", "Average organic content [%]", "processing"]
}