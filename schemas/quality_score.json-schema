{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/quality_score.json-schema",
    "title": "Quality score",
    "description": "JSON schema for quality scoring system implemented at UGGI",
    "type": "object",
    "properties": {
        "quality class": {
            "description": "Test quality class",
            "enum": ["A", "B", "C", "D", "E", "N/A"]
        },
        "quality score": {
            "description": "Test quality score between 0 and 100",
            "type": "number",
            "minimum": 0,
            "maximum": 100
        }
    },
    "required": ["quality class", "quality score"]
}