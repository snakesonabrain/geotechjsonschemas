{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/execution.json-schema",
    "title": "Test execution metadata",
    "description": "Metadata on test execution",
    "type": "object",
    "properties": {
        "executed_by": {
            "description": "Initials or name of test executor",
            "type": "string"
        },
        "execution_date": {
            "description": "Test execution date (start date if the test runs over multiple days)",
            "type": "string",
            "pattern": "^(?:(?:31(\\/|-|\\.)(?:0?[13578]|1[02]))\\1|(?:(?:29|30)(\\/|-|\\.)(?:0?[13-9]|1[0-2])\\2))(?:(?:1[6-9]|[2-9]\\d)?\\d{2})$|^(?:29(\\/|-|\\.)0?2\\3(?:(?:(?:1[6-9]|[2-9]\\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\\d|2[0-8])(\\/|-|\\.)(?:(?:0?[1-9])|(?:1[0-2]))\\4(?:(?:1[6-9]|[2-9]\\d)?\\d{2})$"
        },
        "execution_remarks": {
            "description": "Remarks from test execution",
            "type": "string"
        }
    },
    "required": ["execution_remarks"],
    "dependentRequired": {
        "executed_by": ["execution_date"]
    }
}