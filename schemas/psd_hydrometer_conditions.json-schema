{"$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/psd_hydrometer_conditions.schema.json",
 "title": "PSD sieving raw",
 "description": "JSON schema for hydrometer conditions",
 "type": "object",
 "properties": {
        "starttemperature": {
            "description": "Temperature at the start of the test [°C]",
            "type": "number"
        },
        "solution": {
            "description": "Solution used",
            "enum": ["DEMIN", "DECAL"]
        },
        "suspension_volume": {
            "description": "Initial suspension volume [ml]",
            "type": "number"
        },
        "grain_density": {
            "description": "Grain density used for settling calculation [kg/m3]",
            "type": "number"
        },
        "hydrometer_calibration_id": {
            "description": "ID of the hydrometer calibration"
        },
        "remarks": {
            "description": "Metadata for test conditions",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/testconditions.json-schema"
        }
    },
    "required": ["starttemperature", "solution", "suspension_volume", "grain_density", "hydrometer_calibration_id", "remarks"]
}