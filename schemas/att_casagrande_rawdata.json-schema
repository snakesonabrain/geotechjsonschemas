{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/att_casagrande_rawdata.json-schema",
    "title": "Atterberg limit tests with the Casagrande cup and thread rolling raw data",
    "description": "JSON schema for raw data of Atterberg limit tests with the Casagrande cup",
    "type": "object",
    "properties": {
        "liquidlimit": {
            "description": "Data for the liquid limit test",
            "type": "object",
            "properties": {
                "testpoints": {
                    "description": "Array with points of the individual tests (different water contents)",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "watercontent": {
                                "description": "Water content data for the test point",
                                "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/watercontent_rawdata.json-schema"
                            },
                            "no blows": {
                                "description": "Number of blows",
                                "type": "integer"
                            },
                            "remarks": {
                                "description": "Remarks from test execution",
                                "type": "string"
                            }
                        },
                        "required": ["watercontent", "No blows", "remarks"]
                    }
                },
                "quality": {
                    "description": "Test quality score",
                    "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/quality_score.json-schema"
                },
                "execution": {
                    "description": "Test execution metadata",
                    "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/execution.json-schema"
                }
            },
            "required": ["testpoints", "quality", "execution"]
        },
        "plasticlimit": {
            "description": "Data for the plastic limit test",
            "type": "object",
            "properties": {
                "watercontent": {
                    "description": "Water content data for the test point",
                    "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/watercontent_rawdata.json-schema"
                },
                "quality": {
                    "description": "Test quality score",
                    "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/quality_score.json-schema"
                },
                "execution": {
                    "description": "Test execution metadata",
                    "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/execution.json-schema"
                }
            },
            "required": ["watercontent", "quality", "execution"]
        }
    },
    "required": [ "liquidlimit", "plasticlimit"]
}