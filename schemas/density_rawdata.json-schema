{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/density_rawdata.json-schema",
    "title": "Density raw",
    "description": "JSON schema for raw data of a wet density (proofing ring) test",
    "type": "object",
    "properties": {
        "container ID": {
            "description": "Identifier of the container",
            "type": "string"
        },
        "Container mass [g]": {
            "description": "Mass of the container",
            "type": "number"
        },
        "Container diameter [mm]": {
            "description": "Diameter of the container",
            "type": "number"
        },
        "Container height [mm]": {
            "description": "Height of the container",
            "type": "number"
        },
        "Mass container and wet soil [g]": {
            "description": "Mass of the container and the wet soil",
            "type": "number"
        },
        "watercontent": {
            "description": "Water content data for the test point",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/watercontent_rawdata.json-schema"
        },
        "remarks": {
            "description": "Remarks from test execution",
            "type": "string"
        },
        "quality": {
            "description": "Test execution quality score",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/quality_score.json-schema"
        }
    },
    "required": ["container ID", "Container mass [g]", "Container diameter [mm]", "Container height [mm]", "Mass container and wet soil [g]", "watercontent", "remarks", "quality"]
}