{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/calibration.json-schema",
    "title": "Calibration metadata",
    "description": "Metadata on device or sensor calibration",
    "type": "object",
    "properties": {
        "calibration_id": {
            "description": "ID for the calibration",
            "type": "string"
        },
        "calibration_by": {
            "description": "Initials or name of person doing the calibration",
            "type": "string"
        },
        "calibration_date": {
            "description": "Calibration date",
            "type": "string",
            "pattern": "^(?:(?:31(\\/|-|\\.)(?:0?[13578]|1[02]))\\1|(?:(?:29|30)(\\/|-|\\.)(?:0?[13-9]|1[0-2])\\2))(?:(?:1[6-9]|[2-9]\\d)?\\d{2})$|^(?:29(\\/|-|\\.)0?2\\3(?:(?:(?:1[6-9]|[2-9]\\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00))))$|^(?:0?[1-9]|1\\d|2[0-8])(\\/|-|\\.)(?:(?:0?[1-9])|(?:1[0-2]))\\4(?:(?:1[6-9]|[2-9]\\d)?\\d{2})$"
        },
        "calibration_remarks": {
            "description": "Remarks from calibration",
            "type": "string"
        }
    },
    "required": ["calibration_id", "calibration_by", "calibration_date", "calibration_remarks"]
}