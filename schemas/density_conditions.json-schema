{"$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/density_conditions.schema.json",
 "title": "Conditions and assumptions for the wet density test",
 "description": "JSON schema for density conditions",
 "type": "object",
 "properties": {
        "Specific gravity solids [-]": {
            "description": "Grain density used for settling calculation [kg/m3]",
            "type": "number"
        },
        "remarks": {
            "description": "Metadata for test conditions",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/testconditions.json-schema"
        }
    },
    "required": ["Specific gravity solids [-]", "remarks"]
}