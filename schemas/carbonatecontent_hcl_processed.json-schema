{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/carbonatecontent_hcl_processed.json-schema",
    "title": "Carbonate content (HCl effervescense) processed test data",
    "description": "JSON schema for processed data of carbonate content test (effervescense with HCl)",
    "type": "object",
    "properties": {
        "testpoints": {
            "description": "Array with results of the individual tests (different specimens)",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "Measured pressure [kPa]": {
                        "description": "Measured pressure difference between start and end of test",
                        "type": "number"
                    },
                    "Mass CaCO3 [g]": {
                        "description": "Inferred mass of calcium carbonate",
                        "type": "number"
                    },
                    "Carbonate content [%]": {
                        "description": "Carbonate content (ratio of CaCO3 mass to dry soil mass)",
                        "type": "number"
                    }
                    
                },
                "required": ["Carbonate content [%]"]
            }
        },
        "Average carbonate content [%]": {
            "description": "Average of the carbonate content tests (number used in reporting)",
            "type": "number"
        },
        "quality": {
            "description": "Test processing quality score",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/quality_score.json-schema"
        },
        "processing": {
            "description": "Test processing metadata",
            "$ref": "https://raw.githubusercontent.com/snakesonabrain/geotechjsonschemas/refs/heads/main/schemas/processing.json-schema"
        }
    },
    "required": ["Average carbonate content [%]", "quality", "processing"]
}